{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caption Maker",
  "version": "0.1.0",
  "identifier": "com.captionmaker.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Caption Maker",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": []
  }
}
